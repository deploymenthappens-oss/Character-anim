# Copy to .env for local/docker-compose use, or paste these into Railway's Variables tab.
# Nothing here is required to boot - every value has a sane default (see chat/server.js) - but for any
# public deploy (Railway included) set ADMIN_TOKEN at minimum.

# ---- admin auth (set this before any public deploy) ----
ADMIN_TOKEN=

# ---- reply brain: your own keys first, then free keyless gateways, then built-in rules (chat/llm.js) ----
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
FREE_LLM=on
FREE_LLM_ORDER=llm7,ovh,kilo
REPLY_CACHE_MS=45000

# ---- avatar / script / persona ----
AVATAR_PERSONA=a friendly, witty cartoon co-host
AVATAR_SCRIPT=
AVATAR_LOOP=on
AVATAR_REPLIES=all
AVATAR_SCRIPT_PROTECT=off
AVATAR_VOICE_SCRIPT=on
AVATAR_VOICE_REPLIES=on
AVATAR_IDLE_MS=1100
AVATAR_AR_DIALECT=egy
AVATAR_SPEECH_PAUSED=off

# ---- pure-virtual viewer defaults (view.html) ----
AVATAR_BACKGROUND=aurora
GESTURE_TEST_LIMIT=5

# ---- text-to-speech ----
TTS_ENGINE=edge
TTS_VOICE_EN_EDGE=en-US-AriaNeural
TTS_VOICE_AR_EDGE=ar-EG-SalmaNeural
TTS_EDGE_RATE=0
TTS_EDGE_PITCH=0
TTS_VOICE_EN=en-us+f3
TTS_VOICE_AR=ar+f3
TTS_SPEED=138
TTS_PITCH=72
TTS_AMP=190
TTS_GAP=4

# ---- server ----
PORT=3000
