# Railway > service > Variables. Secrets: any length/characters; surrounding spaces, newlines or quotes are ignored.
ADMIN_TOKEN=            # publisher password (/publish.html). Overrides the fallback in chat/config.js
TTS_ADMIN_TOKEN=        # SEPARATE secret for the TTS dashboard /admin and /admin/api/*  (openssl rand -hex 32). Unset = dashboard disabled
TTS_BACKEND=egy         # egy | cairo | none
# CACHE_DATABASE_URL=   # later: ${{Postgres.DATABASE_URL}} keeps the audio cache across redeploys (or DATABASE_URL). No Volume needed.
# RAILWAY_RUN_UID=0     # only if you DO mount a Volume at /data
# VOICETUT_NUM_STEP=auto   TORCH_THREADS=0   ENGINES=voicetut,edge,espeak   (see tts/.env.example for every TTS setting)
# STREAM_URL=  STREAM_ADMIN_TOKEN=   (default: this container + ADMIN_TOKEN)
# Build-time (Railway service variables): WITH_EGY=1  WITH_CAIRO=0  BAKE_MODEL=0   (CAIRO=1 / BAKE_MODEL=1 make the image much bigger)
# EGY_MIN_MEM_MB=3500  (below this memory limit VoiceTut is skipped and Edge/espeak is used)   EGY_FORCE_VOICETUT=1 overrides
