# Copy these into Railway > your service > Variables (or Colab os.environ). Nothing here is read from code.
# Tokens: ANY length, any characters. Generate one:  openssl rand -hex 32     (or a 128+ char one: openssl rand -base64 96)

# --- secrets (all optional, but set ADMIN_TOKEN to turn the dashboard on)
ADMIN_TOKEN=            # opens /admin and /admin/api/*   (different secret from the next one!)
VOICETUT_TOKEN=         # the Bearer token your Node stream server sends to /tts. Same value on the Node side. Empty = /tts is open.
STREAM_URL=             # https://your-node-stream-server        (enables the dashboard "Stream (view/publish)" tab)
STREAM_ADMIN_TOKEN=     # that Node server's own ADMIN_TOKEN

# --- model / CPU
VOICETUT_NUM_STEP=auto  # or a number from tools/bench.py (lower = faster)
TORCH_THREADS=0         # set to the vCPU count of the Railway plan
ENGINES=voicetut,edge,espeak
HF_TOKEN=               # only if the Hugging Face repo is gated/private

# --- audio cache in a database (optional; no code change): CACHE_DATABASE_URL= (or DATABASE_URL=) postgres://... | sqlite:///file.db ; CACHE_DB_MB=512 ; CACHE_DB=off
# --- persistence (already defaulted in Dockerfile.cpu; needs a Volume mounted at /data)
# SETTINGS_FILE=/data/settings.json   PHRASES_FILE=/data/phrases.txt   HF_HOME=/data/hf   CACHE_DIR=/data/audio-cache
